---
import '../styles/global.css';

const TITLE       = 'Yewdiel Medina | Software Developer';
const DESCRIPTION = 'Software Developer specializing in elegant, scalable web experiences. Explore my projects, skills in React, TypeScript, Node.js, and more.';
const SITE_URL    = Astro.site?.href.replace(/\/$/, '') ?? 'https://yewdielmedina.dev';
const OG_IMAGE    = `${SITE_URL}/avatar.jpg`;

const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Yewdiel Medina',
    jobTitle: 'Software Developer',
    description: DESCRIPTION,
    url: SITE_URL,
    email: 'yewdiel211@gmail.com',
    image: OG_IMAGE,
    sameAs: [
      'https://github.com/YewdielMartinez',
      'https://www.linkedin.com/in/yewdiel-mart%C3%ADnez-medina-0b6752249',
      'https://x.com/yewdiel211',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: TITLE,
    url: SITE_URL,
  },
]);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary -->
		<title>{TITLE}</title>
		<meta name="description" content={DESCRIPTION} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={SITE_URL} />

		<!-- Open Graph -->
		<meta property="og:type"        content="website" />
		<meta property="og:url"         content={SITE_URL} />
		<meta property="og:title"       content={TITLE} />
		<meta property="og:description" content={DESCRIPTION} />
		<meta property="og:image"       content={OG_IMAGE} />
		<meta property="og:image:alt"   content="Yewdiel Medina — Software Developer" />
		<meta property="og:site_name"   content="Yewdiel Medina" />
		<meta property="og:locale"      content="en_US" />

		<!-- Twitter / X Card -->
		<meta name="twitter:card"        content="summary_large_image" />
		<meta name="twitter:site"        content="@yewdiel211" />
		<meta name="twitter:title"       content={TITLE} />
		<meta name="twitter:description" content={DESCRIPTION} />
		<meta name="twitter:image"       content={OG_IMAGE} />
		<meta name="twitter:image:alt"   content="Yewdiel Medina — Software Developer" />

		<!-- Theme color -->
		<meta name="theme-color" content="#F0EEE6" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#262624" media="(prefers-color-scheme: dark)" />

		<!-- Structured data -->
		<script is:inline type="application/ld+json" set:html={jsonLd} />

		<script is:inline>
			if (localStorage.getItem('theme') === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>
	</head>
	<body class="text-gray-900 dark:text-white transition-colors duration-300">
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<slot />
	</body>
</html>

<style is:global>
	.skip-link {
		position: absolute;
		top: 1rem;
		left: 1rem;
		z-index: 9999;
		padding: 0.5rem 1rem;
		background: #111;
		color: #fff;
		border-radius: 0.375rem;
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		transform: translateY(-200%);
		transition: transform 0.2s ease;
	}
	.skip-link:focus {
		transform: translateY(0);
		outline: 2px solid #fff;
		outline-offset: 2px;
	}
	.dark .skip-link { background: #fff; color: #111; }

	body {
		font-family: 'NB International', sans-serif;
		background-color: rgb(240, 238, 230);
	}

	.dark body {
		background-color: rgb(38, 38, 36);
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: 'NB International', sans-serif;
		font-weight: 400;
		letter-spacing: -0.02em;
	}

	/* View Transitions */
	:root {
		view-transition-name: none;
	}

	::view-transition {
		pointer-events: none;
	}

	::view-transition-group(vt-element-animation),
	::view-transition-group(vt-element-animation-closing) {
		animation-duration: 500ms;
		animation-timing-function: cubic-bezier(0.38, 0.49, 0, 1);
	}

	::view-transition-old(vt-element-animation),
	::view-transition-new(vt-element-animation),
	::view-transition-old(vt-element-animation-closing),
	::view-transition-new(vt-element-animation-closing) {
		height: 100%;
		min-height: 100%;
		overflow: clip;
		object-position: left top;
	}

	@keyframes vt-fade-in {
		from { opacity: 0; }
	}

	@keyframes vt-fade-out {
		to { opacity: 0; }
	}

	::view-transition-old(vt-element-animation) {
		animation: vt-fade-out 200ms both cubic-bezier(0.38, 0.49, 0, 1);
	}

	::view-transition-new(vt-element-animation) {
		animation: vt-fade-in 200ms both cubic-bezier(0.38, 0.49, 0, 1);
	}

	::view-transition-old(vt-element-animation-closing) {
		animation: vt-fade-in 200ms both cubic-bezier(0.75, 0, 0.41, -0.06);
	}

	::view-transition-new(vt-element-animation-closing) {
		animation: vt-fade-out 200ms both cubic-bezier(0.75, 0, 0.41, -0.06);
	}
</style>

<script>
	// Initialize language from localStorage or default to English
	if (!localStorage.getItem('language')) {
		localStorage.setItem('language', 'en');
	}
</script>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	// Refresh once both Experience and Work pins are guaranteed to exist.
	// First pass: fires when static resources load (covers most cases).
	// Second pass: deferred one frame to catch any triggers created after load.
	window.addEventListener('load', () => {
		ScrollTrigger.refresh();
		requestAnimationFrame(() => ScrollTrigger.refresh());
	});

	document.addEventListener('DOMContentLoaded', () => {
		// ── Contact section reveals ──────────────────────────────
		const contactHeading = document.querySelector<HTMLElement>('#contact h2');
		if (contactHeading) {
			gsap.fromTo(
				contactHeading,
				{ opacity: 0, y: 40, filter: 'blur(8px)' },
				{
					opacity: 1, y: 0, filter: 'blur(0px)',
					duration: 0.9, ease: 'power3.out',
					scrollTrigger: { trigger: contactHeading, start: 'top 82%', once: true },
				}
			);
		}

		const contactSubtitle = document.querySelector<HTMLElement>('#contact > div > p');
		if (contactSubtitle) {
			gsap.fromTo(
				contactSubtitle,
				{ opacity: 0, y: 20 },
				{
					opacity: 1, y: 0,
					duration: 0.65, ease: 'power2.out',
					scrollTrigger: { trigger: contactSubtitle, start: 'top 84%', once: true },
				}
			);
		}

		// Stagger form fields in
		const formFields = document.querySelectorAll('#contact-form .mb-6');
		if (formFields.length) {
			gsap.set(formFields, { opacity: 0, y: 20 });
			gsap.to(formFields, {
				opacity: 1, y: 0,
				duration: 0.55, ease: 'power2.out',
				stagger: 0.1,
				scrollTrigger: { trigger: '#contact-form', start: 'top 80%', once: true },
			});
		}

		const submitBtn = document.getElementById('submit-button');
		if (submitBtn) {
			gsap.set(submitBtn, { opacity: 0, y: 12 });
			gsap.to(submitBtn, {
				opacity: 1, y: 0,
				duration: 0.5, ease: 'back.out(1.2)',
				scrollTrigger: { trigger: '#contact-form', start: 'top 72%', once: true },
			});
		}
	});
</script>
