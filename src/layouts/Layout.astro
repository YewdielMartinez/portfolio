---
import '../styles/global.css';

const TITLE       = 'Yewdiel Medina | Software Developer';
const DESCRIPTION = 'Full-stack software developer specializing in React, React Native, .NET and PHP. Explore web, mobile and backend projects, plus open tools like LOON and Motion Kit.';
const SITE_URL    = Astro.site?.href.replace(/\/$/, '') ?? 'https://yewdielmedina.dev';
const OG_IMAGE    = `${SITE_URL}/avatar.jpg`;

const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Yewdiel Medina',
    jobTitle: 'Software Developer',
    description: DESCRIPTION,
    url: SITE_URL,
    email: 'yewdiel211@gmail.com',
    image: OG_IMAGE,
    sameAs: [
      'https://github.com/YewdielMartinez',
      'https://www.linkedin.com/in/yewdiel-mart%C3%ADnez-medina-0b6752249',
      'https://x.com/yewdiel211',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: TITLE,
    url: SITE_URL,
  },
]);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary -->
		<title>{TITLE}</title>
		<meta name="description" content={DESCRIPTION} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={SITE_URL} />

		<!-- Open Graph -->
		<meta property="og:type"        content="website" />
		<meta property="og:url"         content={SITE_URL} />
		<meta property="og:title"       content={TITLE} />
		<meta property="og:description" content={DESCRIPTION} />
		<meta property="og:image"       content={OG_IMAGE} />
		<meta property="og:image:alt"   content="Yewdiel Medina — Software Developer" />
		<meta property="og:site_name"   content="Yewdiel Medina" />
		<meta property="og:locale"      content="en_US" />

		<!-- Twitter / X Card -->
		<meta name="twitter:card"        content="summary_large_image" />
		<meta name="twitter:site"        content="@yewdiel211" />
		<meta name="twitter:title"       content={TITLE} />
		<meta name="twitter:description" content={DESCRIPTION} />
		<meta name="twitter:image"       content={OG_IMAGE} />
		<meta name="twitter:image:alt"   content="Yewdiel Medina — Software Developer" />

		<meta name="theme-color" content="#ffffff" />

		<!-- Structured data -->
		<script is:inline type="application/ld+json" set:html={jsonLd} />

		<!--
			Runs before first paint: theme and language from storage (or the OS theme),
			`.js` to enable entrance states, and a safety net that reveals everything
			if the motion module has not booted within 2.5 s.
		-->
		<script is:inline>
			(function () {
				var root = document.documentElement;
				root.classList.add('js');
				try {
					var theme = localStorage.getItem('theme');
					if (theme === 'dark' || (!theme && matchMedia('(prefers-color-scheme: dark)').matches)) {
						root.classList.add('dark');
						document.querySelector('meta[name="theme-color"]').setAttribute('content', '#0a0a0a');
					}
					if (localStorage.getItem('language') === 'es') root.lang = 'es';
				} catch (e) {}
				setTimeout(function () {
					if (!root.classList.contains('motion-ready')) root.classList.add('motion-failed');
				}, 2500);
			})();
		</script>
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<slot />
		<script>
			import '../scripts/main';
		</script>
	</body>
</html>
