---
import { t } from '../lib/t';
---

<!-- CV viewer: a Motion Kit dialog that renders the PDF with PDF.js (iframes fail on phones). -->
<dialog class="mk-dialog cv-dialog" data-cv-dialog aria-labelledby="cv-title">
  <header class="cv-dialog__head" data-mk-part="header">
    <h2 id="cv-title" class="t-lead" data-i18n="cv.title">{t('cv.title')}</h2>
    <div class="cv-dialog__actions">
      <div
        class="mk-segmented cv-dialog__langs"
        data-cv-langs
        aria-label={t('cv.language')}
        data-i18n-attr="aria-label:cv.language"
      >
        <button type="button" data-mk-tab data-lang="es" aria-selected="false" lang="es">ES</button>
        <button type="button" data-mk-tab data-lang="en" aria-selected="true" lang="en">EN</button>
        <span data-mk-indicator></span>
      </div>
      <a class="pill cv-dialog__download" data-cv-download href={t('cv.file')} download={t('cv.filename')}>
        <span data-i18n="cv.download">{t('cv.download')}</span> ↓
      </a>
      <button
        type="button"
        class="mk-button mk-button--icon mk-button--tonal"
        data-mk-part="close"
        autofocus
        aria-label={t('dialog.close')}
        data-i18n-attr="aria-label:dialog.close"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </header>
  <div class="cv-dialog__body" data-mk-part="body" data-cv-body>
    <p class="cv-dialog__status t-small text-muted" role="status" data-cv-status></p>
    <div class="cv-dialog__pages" data-cv-pages></div>
    <p class="cv-dialog__error t-label" data-cv-error hidden>
      <span data-i18n="cv.error">{t('cv.error')}</span>
      <a class="link" data-cv-link href={t('cv.file')} target="_blank" rel="noopener" data-i18n="cv.open">{t('cv.open')}</a>
    </p>
  </div>
</dialog>

<style is:global>
  .cv-dialog {
    --mk-dialog-width: 880px;
    --mk-dialog-bg: var(--bg);
    --mk-dialog-shadow: var(--shadow);
    width: min(var(--mk-dialog-width), 100vw - 2 * var(--gutter));
    height: calc(100dvh - 2 * var(--gutter));
    max-height: calc(100dvh - 2 * var(--gutter));
    color: var(--fg);
  }

  .dark .cv-dialog {
    --mk-dialog-bg: #141414;
  }

  .cv-dialog::backdrop {
    background: rgb(0 0 0 / 0.35);
    backdrop-filter: none;
  }

  .dark .cv-dialog::backdrop {
    background: rgb(0 0 0 / 0.7);
  }

  .mk-dialog [data-mk-part='header'].cv-dialog__head {
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding: clamp(1rem, 2.5vw, 1.75rem) clamp(1rem, 3vw, 2rem);
  }

  .cv-dialog__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
  }

  .cv-dialog__langs > [data-mk-tab] {
    height: 2.25rem;
    padding-inline: 0.9rem;
    color: var(--fg);
    font-size: 0.875rem;
    font-weight: 400;
  }

  .cv-dialog__langs > [data-mk-tab][aria-selected='true'] {
    color: var(--bg);
  }

  .cv-dialog__download {
    padding: 0.7rem 1.2rem;
    font-size: 0.9375rem;
  }

  /* Paper on a grey desk, also in dark mode */
  .mk-dialog [data-mk-part='body'].cv-dialog__body {
    position: relative;
    padding: clamp(0.75rem, 3vw, 2rem);
    background: var(--surface);
  }

  .cv-dialog__pages {
    display: grid;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    max-width: 820px;
    margin-inline: auto;
  }

  .cv-dialog__pages canvas {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    background: #fff;
    box-shadow: var(--shadow-soft);
  }

  .cv-dialog__status:empty {
    display: none;
  }

  .cv-dialog__status {
    padding-block: 2rem;
    text-align: center;
  }

  .cv-dialog__error {
    display: grid;
    justify-items: center;
    gap: 1rem;
    max-width: 30rem;
    margin: 3rem auto;
    text-align: center;
  }

  .cv-dialog__error[hidden] {
    display: none;
  }

  @media (max-width: 679px) {
    .cv-dialog {
      height: 100dvh;
    }

    .cv-dialog__actions {
      width: 100%;
      margin-left: 0;
    }

    .cv-dialog__actions > [data-mk-part='close'] {
      margin-left: auto;
    }
  }
</style>
