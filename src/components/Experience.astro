---
import SheetTitle from './SheetTitle.astro';
import { experience } from '../data/experience';
---

<section id="experience" class="sheet gutter" data-section-label="nav.experience" tabindex="-1">
  <SheetTitle line1="experience.title1" line2="experience.title2" />
  <ol class="xp" data-flow>
    {experience.en.map((item, i) => (
      <li class="xp__row">
        <p class="t-label text-muted" data-i18n={`jobs.${i}.year`}>{item.year}</p>
        <div class="xp__role">
          <p class="t-lead" data-i18n={`jobs.${i}.company`}>{item.company}</p>
          <p class="t-label text-muted" data-i18n={`jobs.${i}.position`}>{item.position}</p>
        </div>
        <p class="t-body" data-i18n={`jobs.${i}.description`}>{item.description}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .xp {
    margin-top: clamp(3rem, 9vh, 6rem);
    border-bottom: 1px solid var(--line);
  }

  .xp__row {
    display: grid;
    gap: 0.75rem 2rem;
    padding-block: clamp(1.5rem, 3.5vh, 2.5rem);
    border-top: 1px solid var(--line);
  }

  .xp__role {
    display: grid;
    gap: 0.4rem;
  }

  @media (min-width: 768px) {
    .xp__row {
      grid-template-columns: 3fr 4fr 5fr;
    }
  }
</style>
