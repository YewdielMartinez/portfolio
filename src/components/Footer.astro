---
import { t } from '../lib/t';
import { personalInfo } from '../data/personal';

const links = [
  { label: 'GitHub', href: personalInfo.social.github },
  { label: 'LinkedIn', href: personalInfo.social.linkedin },
  { label: 'X', href: personalInfo.social.twitter },
];
const year = new Date().getFullYear();
---

<!-- Transparent spacer at the end of the flow; scrolling through it reveals the fixed footer behind <main>. -->
<div class="footer-phantom" data-footer-phantom aria-hidden="true"></div>

<footer class="site-footer gutter" data-footer>
  <p class="site-footer__title" data-fit data-footer-title data-i18n="footer.title">{t('footer.title')}</p>
  <div class="site-footer__bottom">
    <ul class="site-footer__links t-label">
      <li><a class="stretch" href={`mailto:${personalInfo.email}`}>{personalInfo.email}</a></li>
      {links.map((link) => (
        <li><a class="stretch" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></li>
      ))}
    </ul>
    <small class="t-small">© {year} Yewdiel Medina · <span data-i18n="footer.rights">{t('footer.rights')}</span></small>
  </div>
</footer>

<style>
  .footer-phantom {
    height: 100dvh;
    pointer-events: none;
  }

  /* Revealed footer from spencergabor.com (Footer, data-v-29726d37), inverted to black */
  .site-footer {
    position: fixed;
    inset: auto 0 0;
    z-index: 0;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: clamp(1.5rem, 4vh, 3rem);
    padding-bottom: max(env(safe-area-inset-bottom), 1.25rem);
    background: var(--fg);
    color: var(--bg);
    translate: 0 calc(var(--footer-offset, 0) * 1px);
  }

  .site-footer__title {
    align-self: flex-start;
    font-size: clamp(5rem, 22vw, 26rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    margin-left: -0.04em;
    transform: scaleY(var(--footer-scale, 1));
    transform-origin: 50% 100%;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem 2rem;
    padding-right: 4rem;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem clamp(1rem, 3vw, 3rem);
  }
</style>
