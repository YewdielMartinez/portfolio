---
import ProjectDetail from './ProjectDetail.astro';
import { t } from '../lib/t';
import { projects } from '../data/projects';
---

<!-- Motion Kit dialog: grows out of the clicked card, drags away on touch, folds back on close. -->
<dialog class="mk-dialog project-dialog" data-project-dialog aria-labelledby="pd-title">
  <button
    type="button"
    class="pd__close"
    data-mk-part="close"
    aria-label={t('dialog.close')}
    data-i18n-attr="aria-label:dialog.close"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" />
    </svg>
  </button>
  <div class="project-dialog__body" data-mk-part="body" data-dialog-content></div>
</dialog>

{projects.en.map((project, i) => (
  <template data-project-template={i}>
    <ProjectDetail project={project} index={i} />
  </template>
))}

<style is:global>
  .project-dialog {
    --mk-dialog-width: 960px;
    --mk-dialog-bg: var(--bg);
    --mk-dialog-shadow: var(--shadow);
    width: min(var(--mk-dialog-width), 100vw - 2 * var(--gutter));
    max-height: calc(100dvh - 2 * var(--gutter));
    color: var(--fg);
  }

  .dark .project-dialog {
    --mk-dialog-bg: #141414;
  }

  .project-dialog::backdrop {
    background: rgb(0 0 0 / 0.35);
    backdrop-filter: none;
  }

  .dark .project-dialog::backdrop {
    background: rgb(0 0 0 / 0.7);
  }

  .mk-dialog [data-mk-part='body'].project-dialog__body {
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }

  /* The kit's close part is a muted 40 px circle; this one floats over the cover. */
  .mk-dialog .pd__close {
    position: absolute;
    top: clamp(0.75rem, 2vw, 1.25rem);
    right: clamp(0.75rem, 2vw, 1.25rem);
    z-index: 2;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--bg);
    color: var(--fg);
    box-shadow: var(--shadow-soft);
    transition: scale 0.8s var(--ease-out-elastic);
  }

  .mk-dialog .pd__close:hover {
    background: var(--bg);
    color: var(--fg);
  }

  .pd__close:active {
    scale: 0.9;
  }

  .pd {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  .pd__media {
    border-radius: 1.75rem;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--surface);
  }

  .pd__media .pd__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .pd__head {
    display: grid;
    gap: 1.25rem;
  }

  .pd__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 3rem;
  }

  .pd__meta dt {
    margin-bottom: 0.25rem;
  }

  .pd__desc {
    max-width: 52ch;
  }

  .pd__features ul {
    display: grid;
    margin-top: 0.75rem;
    border-top: 1px solid var(--line);
  }

  .pd__features li {
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
  }

  .pd__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pd__tags li {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .pd__install {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 34rem;
    padding: 0.85rem 0.85rem 0.85rem 1.25rem;
    border-radius: 999px;
    background: var(--surface);
  }

  .pd__install code {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.95rem;
  }

  .pd__copy {
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    transition: scale 0.8s var(--ease-out-elastic);
  }

  .pd__copy:active {
    scale: 0.92;
  }

  /* One per row: the captures are device mockups with wide margins */
  .pd__shots {
    display: grid;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .pd__shot-frame {
    overflow: hidden;
    border-radius: 1.25rem;
    background: var(--surface);
  }

  .pd__shot-frame .pd__shot {
    display: block;
    width: 100%;
    height: auto;
  }

  /* 4:3 mockup → 16:9 frame, zoomed so the device fills it */
  .pd__shot-frame--wide {
    aspect-ratio: 16 / 9;
  }

  .pd__shot-frame--wide .pd__shot {
    height: 100%;
    object-fit: cover;
    scale: 1.22;
  }

  /* Portrait/square captures (phones) keep their full frame at a readable width */
  .pd__shot-frame:not(.pd__shot-frame--wide) {
    max-width: 30rem;
  }

  .pd__video {
    width: 100%;
    border-radius: 1.25rem;
    background: #000;
  }

  .pd__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .pill--ghost {
    background: transparent;
    color: var(--fg);
    box-shadow: inset 0 0 0 1px var(--line);
  }
</style>
