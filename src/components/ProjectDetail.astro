---
import ProjectImage from './ProjectImage.astro';
import { t } from '../lib/t';
import { loadProjectImage } from '../lib/images';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index: i } = Astro.props;
const demo = project.demo ?? (project.link && project.link !== '#' ? project.link : undefined);

// Landscape captures are device mockups with wide margins: frame them tighter.
const shots = await Promise.all(
  (project.images ?? []).map(async (src) => {
    const meta = await loadProjectImage(src);
    return { src, wide: !!meta && meta.width / meta.height > 1.2 };
  }),
);
---

<article class="pd">
  {project.image && (
    <div class="pd__media">
      <ProjectImage
        src={project.image}
        widths={[640, 960, 1400]}
        sizes="(min-width: 1000px) 900px, 100vw"
        class="pd__img"
      />
    </div>
  )}
  <header class="pd__head">
    <h2 id="pd-title" class="pd__title t-h2" data-mk-shared="title" data-i18n={`projects.${i}.title`}>
      {project.title}
    </h2>
    <dl class="pd__meta t-label">
      <div>
        <dt class="text-muted" data-i18n="dialog.year">{t('dialog.year')}</dt>
        <dd data-i18n={`projects.${i}.year`}>{project.year}</dd>
      </div>
      <div>
        <dt class="text-muted" data-i18n="dialog.role">{t('dialog.role')}</dt>
        <dd data-i18n={`projects.${i}.role`}>{project.role}</dd>
      </div>
    </dl>
  </header>

  <p class="pd__desc t-body" data-i18n={`projects.${i}.${project.detailedDescription ? 'detailedDescription' : 'description'}`}>
    {project.detailedDescription ?? project.description}
  </p>

  {project.install && (
    <div class="pd__install">
      <code>{project.install}</code>
      <button type="button" class="pd__copy t-small" data-copy={project.install} data-i18n="dialog.copy">{t('dialog.copy')}</button>
    </div>
  )}

  {project.features && (
    <section class="pd__features">
      <h3 class="t-label text-muted" data-i18n="dialog.features">{t('dialog.features')}</h3>
      <ul>
        {project.features.map((feature, j) => (
          <li class="t-label" data-i18n={`projects.${i}.features.${j}`}>{feature}</li>
        ))}
      </ul>
    </section>
  )}

  <ul class="pd__tags t-small">
    {project.tags.map((tag, j) => <li data-i18n={`projects.${i}.tags.${j}`}>{tag}</li>)}
  </ul>

  {project.images && project.images.length > 0 && (
    <section class="pd__gallery">
      <h3 class="t-label text-muted" data-i18n="dialog.gallery">{t('dialog.gallery')}</h3>
      <div class="pd__shots">
        {shots.map(({ src, wide }) => (
          <div class:list={['pd__shot-frame', wide && 'pd__shot-frame--wide']}>
            <ProjectImage
              src={src}
              alt={`${project.title} — screenshot`}
              widths={[640, 960, 1400]}
              sizes="(min-width: 1000px) 880px, 100vw"
              class="pd__shot"
            />
          </div>
        ))}
      </div>
    </section>
  )}

  {project.video && (
    <video class="pd__video" src={project.video} controls preload="none" playsinline></video>
  )}

  {(demo || project.github || project.npm) && (
    <div class="pd__links">
      {demo && (
        <a class="pill" href={demo} target="_blank" rel="noopener noreferrer">
          <span data-i18n="dialog.demo">{t('dialog.demo')}</span> ↗
        </a>
      )}
      {project.npm && project.npm !== demo && (
        <a class="pill pill--ghost" href={project.npm} target="_blank" rel="noopener noreferrer">npm ↗</a>
      )}
      {project.github && (
        <a class="pill pill--ghost" href={project.github} target="_blank" rel="noopener noreferrer">
          <span data-i18n="dialog.code">{t('dialog.code')}</span> ↗
        </a>
      )}
    </div>
  )}
</article>
