---
import SheetTitle from './SheetTitle.astro';
import ProjectImage from './ProjectImage.astro';
import Pile from './Pile.astro';
import { t } from '../lib/t';
import { projects } from '../data/projects';

const all = projects.en.map((project, index) => ({ project, index }));
const featured = all.filter(({ project }) => project.image);
---

<section id="work" class="sheet work" data-section-label="nav.work" tabindex="-1">
  <div class="gutter">
    <SheetTitle line1="work.title1" line2="work.title2" />
  </div>

  <div
    class="carousel"
    data-carousel
    tabindex="0"
    role="region"
    aria-roledescription="carousel"
    aria-label={t('work.carousel')}
    data-i18n-attr="aria-label:work.carousel"
  >
    {featured.map(({ project, index }, k) => (
      <button type="button" class="carousel__slide" data-project={index} style={`--k:${k}`}>
        <span class="carousel__media">
          <ProjectImage
            src={project.image}
            widths={[400, 640, 960]}
            sizes="(min-width: 768px) 30rem, 78vw"
            class="carousel__img"
          />
        </span>
        <span class="carousel__title t-label">
          <span data-i18n={`projects.${index}.title`}>{project.title}</span>
          <span class="text-muted" data-i18n={`projects.${index}.year`}>{project.year}</span>
        </span>
      </button>
    ))}
  </div>
  <p class="gutter carousel__hint t-small text-muted" data-i18n="work.drag">{t('work.drag')}</p>

  <div class="gutter archive">
    <h3 class="archive__title t-lead" data-words data-i18n="work.archive">{t('work.archive')}</h3>
    <ul class="archive__grid">
      {all.map(({ project, index }) => (
        <li><Pile project={project} index={index} /></li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Curved inertia carousel (spencergabor.com Carousel.global, data-v-3a0fc0d6) */
  .carousel {
    --slide-w: min(30rem, 78vw);
    position: relative;
    display: flex;
    gap: 1rem;
    column-gap: 1rem;
    margin-top: clamp(3rem, 8vh, 6rem);
    padding-inline: var(--gutter);
    overflow-x: auto;
    user-select: none;
    -webkit-user-select: none;
    outline-offset: -4px;
  }

  :global(.js) .carousel {
    display: block;
    height: calc(var(--slide-w) * 0.625 + 6.5rem);
    padding: 0;
    overflow-x: clip;
    overflow-y: visible;
    touch-action: pan-y;
    cursor: grab;
  }

  :global(.js) .carousel:active {
    cursor: grabbing;
  }

  .carousel__slide {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: var(--slide-w);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: inherit;
  }

  :global(.js) .carousel__slide {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 50% 70vw;
    translate: calc(var(--x, -9999) * 1px) calc(cos(var(--t, 0) * 3.14 / 1000) * -3rem + 3rem);
    rotate: calc(var(--t, 0) * 0.03deg);
    will-change: translate, rotate;
  }

  .carousel__media {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 1rem;
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-soft);
    transition:
      scale 1.4s var(--ease-out-elastic),
      translate 1.4s var(--ease-out-elastic);
    transition-delay: calc(sin(var(--k) * 1.5708) * 0.12s);
  }

  .carousel__media :global(.carousel__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    pointer-events: none;
  }

  .carousel__title {
    display: flex;
    gap: 0.6rem;
  }

  :global(.js) .carousel__title {
    opacity: max(0, cos(var(--t, 0) * 3.14 / 600));
  }

  .carousel__slide:focus-visible {
    outline: none;
  }

  .carousel__slide:focus-visible .carousel__media {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
  }

  .carousel__hint {
    margin-top: 1rem;
    text-align: center;
  }

  .archive {
    margin-top: clamp(6rem, 16vh, 11rem);
  }

  .archive__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3rem, 8vw, 6rem) clamp(1.25rem, 5vw, 4.5rem);
    margin-top: clamp(2.5rem, 6vh, 4rem);
  }

  @media (min-width: 768px) {
    .archive__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
