---
import SheetTitle from './SheetTitle.astro';
import { t } from '../lib/t';
import { personalInfo } from '../data/personal';

// Non-PUBLIC_ vars are read at build time and handed to the client through data attributes.
const PUBLIC_KEY = import.meta.env.PUBLIC_KEY;
const TEMPLATE_ID = import.meta.env.TEMPLATE_ID;
const SERVICE_ID = import.meta.env.SERVICE_ID;
---

<section
  id="contact"
  class="sheet gutter"
  data-section-label="nav.contact"
  tabindex="-1"
  data-public-key={PUBLIC_KEY}
  data-template-id={TEMPLATE_ID}
  data-service-id={SERVICE_ID}
>
  <div class="contact">
    <SheetTitle line1="contact.title1" line2="contact.title2" />
    <!-- Motion Kit fields and rolling button; status goes to the page toaster. -->
    <form id="contact-form" class="contact__form" data-flow novalidate>
      <label class="mk-field">
        <span class="mk-field__label" data-i18n="contact.name">{t('contact.name')}</span>
        <input name="name" type="text" required minlength="2" maxlength="100" autocomplete="name" aria-describedby="contact-name-hint" />
        <span id="contact-name-hint" class="mk-field__hint" data-field-hint hidden data-i18n="contact.nameHint">{t('contact.nameHint')}</span>
      </label>
      <label class="mk-field">
        <span class="mk-field__label" data-i18n="contact.email">{t('contact.email')}</span>
        <input name="email" type="email" required maxlength="254" autocomplete="email" aria-describedby="contact-email-hint" />
        <span id="contact-email-hint" class="mk-field__hint" data-field-hint hidden data-i18n="contact.emailHint">{t('contact.emailHint')}</span>
      </label>
      <label class="mk-field field--wide">
        <span class="mk-field__label" data-i18n="contact.message">{t('contact.message')}</span>
        <textarea name="message" rows="4" required minlength="10" maxlength="5000" aria-describedby="contact-message-hint"></textarea>
        <span id="contact-message-hint" class="mk-field__hint" data-field-hint hidden data-i18n="contact.messageHint">{t('contact.messageHint')}</span>
      </label>
      <div class="contact__actions field--wide">
        <button type="submit" class="mk-button mk-button--roll contact__send" data-send>
          <span
            class="mk-roll"
            data-text={t('contact.send')}
            data-i18n="contact.send"
            data-i18n-attr="data-text:contact.send"
          >{t('contact.send')}</span>
          <span class="mk-roll__arrow" aria-hidden="true"><span data-icon="→">→</span></span>
        </button>
        <span class="mk-success contact__done" data-sent hidden aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22">
            <path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </div>
      <p class="contact__status t-small field--wide" role="status" aria-live="polite" data-contact-status></p>
      <p class="t-small text-muted field--wide">
        <span data-i18n="contact.direct">{t('contact.direct')}</span>
        <a class="link" href={`mailto:${personalInfo.email}`}>{personalInfo.email}</a>
      </p>
    </form>
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: clamp(3rem, 8vw, 6rem);
  }

  @media (min-width: 900px) {
    .contact {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  .contact__form {
    display: grid;
    gap: 2rem 1.5rem;
  }

  @media (min-width: 640px) {
    .contact__form {
      grid-template-columns: 1fr 1fr;
    }

    .field--wide {
      grid-column: 1 / -1;
    }
  }

  /* Motion Kit .mk-field on the portfolio's surface and type */
  .contact__form .mk-field {
    --mk-field-radius: 1.25rem;
    gap: 0.5rem;
  }

  .contact__form .mk-field__label {
    padding-inline: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .contact__form .mk-field :is(input, textarea) {
    padding: 1rem 1.25rem;
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    letter-spacing: -0.01em;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .contact__status:empty {
    display: none;
  }

  .contact__status[data-error] {
    color: var(--mk-error);
  }

  .contact__send {
    --mk-button-height: 3.25rem;
    --mk-button-padding: 1.75rem;
    gap: 0.6rem;
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .contact__send.mk-loading::before {
    display: block;
  }

  /* The kit's roll travel (150 %) fits a 40 px button; this one is taller. */
  .contact__send :global(.mk-roll::after) {
    inset: 220% 0 auto;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .contact__send:hover :global(.mk-roll) {
      transform: translateY(-220%);
    }
  }

  .contact__done {
    display: inline-grid;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--fg);
    color: var(--bg);
  }

  .contact__done[hidden] {
    display: none;
  }
</style>
