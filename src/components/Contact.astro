---
import SheetTitle from './SheetTitle.astro';
import { t } from '../lib/t';

// Non-PUBLIC_ vars are read at build time and handed to the client through data attributes.
const PUBLIC_KEY = import.meta.env.PUBLIC_KEY;
const TEMPLATE_ID = import.meta.env.TEMPLATE_ID;
const SERVICE_ID = import.meta.env.SERVICE_ID;
---

<section
  id="contact"
  class="sheet gutter"
  data-section-label="nav.contact"
  tabindex="-1"
  data-public-key={PUBLIC_KEY}
  data-template-id={TEMPLATE_ID}
  data-service-id={SERVICE_ID}
>
  <div class="contact">
    <SheetTitle line1="contact.title1" line2="contact.title2" />
    <form id="contact-form" class="contact__form" data-flow>
      <label class="field">
        <span class="t-small text-muted" data-i18n="contact.name">{t('contact.name')}</span>
        <input name="name" type="text" required autocomplete="name" />
      </label>
      <label class="field">
        <span class="t-small text-muted" data-i18n="contact.email">{t('contact.email')}</span>
        <input name="email" type="email" required autocomplete="email" />
      </label>
      <label class="field field--wide">
        <span class="t-small text-muted" data-i18n="contact.message">{t('contact.message')}</span>
        <textarea name="message" rows="4" required></textarea>
      </label>
      <div class="contact__actions field--wide">
        <button type="submit" class="pill" data-send>
          <span data-i18n="contact.send">{t('contact.send')}</span>
        </button>
        <p class="t-small" role="status" aria-live="polite" data-form-status></p>
      </div>
    </form>
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: clamp(3rem, 8vw, 6rem);
  }

  @media (min-width: 900px) {
    .contact {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  .contact__form {
    display: grid;
    gap: 2rem 1.5rem;
  }

  @media (min-width: 640px) {
    .contact__form {
      grid-template-columns: 1fr 1fr;
    }

    .field--wide {
      grid-column: 1 / -1;
    }
  }

  .field {
    display: grid;
    gap: 0.35rem;
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.5rem 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: clamp(1.1rem, 1.5vw, 1.5rem);
    letter-spacing: -0.02em;
    resize: vertical;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--fg);
    box-shadow: 0 1px 0 var(--fg);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
</style>
