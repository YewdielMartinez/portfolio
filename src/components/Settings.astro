---
import { t } from '../lib/t';
---

<div class="settings" data-settings>
  <div class="settings__options" id="settings-options" data-settings-options inert>
    <button
      type="button"
      class="settings__opt"
      style="--i:0"
      data-theme-toggle
      aria-label={t('settings.theme')}
      data-i18n-attr="aria-label:settings.theme"
    >
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" fill="currentColor" />
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5" fill="currentColor" />
        <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
    <button
      type="button"
      class="settings__opt t-small"
      style="--i:1"
      data-lang-toggle
      aria-label={t('settings.switchLang')}
      data-i18n-attr="aria-label:settings.switchLang"
    >
      <span data-i18n="settings.langCode">{t('settings.langCode')}</span>
    </button>
  </div>
  <button
    type="button"
    class="settings__toggle"
    data-settings-toggle
    aria-expanded="false"
    aria-controls="settings-options"
    aria-label={t('settings.open')}
    data-i18n-attr="aria-label:settings.open"
  >
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5" />
      <path d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor" />
    </svg>
  </button>
</div>

<style>
  /* Radial picker from spencergabor.com (color picker, data-v-edf4f13d) */
  .settings {
    position: fixed;
    right: var(--gutter);
    bottom: max(env(safe-area-inset-bottom), 1.25rem);
    z-index: 50;
    display: grid;
    place-items: center;
    --radius: 3.6rem;
  }

  .settings__options {
    display: grid;
    place-items: center;
    grid-area: 1 / 1;
  }

  .settings__toggle,
  .settings__opt {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .settings__toggle {
    position: relative;
    z-index: 1;
    width: 3rem;
    height: 3rem;
    transition: scale 0.8s var(--ease-out-elastic);
  }

  .settings__toggle:active {
    scale: 0.9;
  }

  .settings__opt {
    width: 2.6rem;
    height: 2.6rem;
    opacity: 0;
    scale: 0.5;
    transition:
      translate 0.15s cubic-bezier(0.55, 0.055, 0.675, 0.19),
      scale 0.15s cubic-bezier(0.55, 0.055, 0.675, 0.19),
      opacity 0.15s;
  }

  .settings[data-open] .settings__opt {
    opacity: 1;
    scale: 1;
    translate:
      calc(sin(var(--i) * 0.9 + 1.5708) * var(--radius) * -1)
      calc(cos(var(--i) * 0.9 + 1.5708) * var(--radius));
    transition-duration: 0.5s;
    transition-timing-function: var(--ease-out-elastic);
    transition-delay: calc(var(--i) * 0.05s);
  }

  .icon-sun,
  :global(.dark) .icon-moon {
    display: none;
  }

  :global(.dark) .icon-sun {
    display: block;
  }
</style>
