---
import { Image } from 'astro:assets';
import SheetTitle from './SheetTitle.astro';
import avatar from '../assets/avatar.jpg';
import { t } from '../lib/t';
---

<section id="about" class="sheet gutter" data-section-label="nav.about" tabindex="-1">
  <div class="about">
    <div class="about__photo-wrap" data-mk="parallax">
      <Image
        src={avatar}
        alt="Yewdiel Medina"
        widths={[360, 560, 800].filter((w) => w <= avatar.width)}
        sizes="(min-width: 768px) 36vw, 100vw"
        format="webp"
        class="about__photo"
        data-mk-parallax-target
      />
    </div>
    <div class="about__text">
      <SheetTitle line1="about.hello" line2="about.name" muted={false} />
      <div class="about__copy">
        <p class="t-body" data-mk="fill-text" data-i18n="about.bio">{t('about.bio')}</p>
        <p class="t-body" data-mk="fill-text" data-i18n="about.bio2">{t('about.bio2')}</p>
      </div>
      <!-- Without JS "View CV" is a plain link to the PDF; with JS it opens the viewer (CvDialog). -->
      <div class="about__cv" data-flow>
        <a class="pill" href={t('cv.file')} data-cv-open data-i18n-attr="href:cv.file">
          <span data-i18n="cv.view">{t('cv.view')}</span>
        </a>
        <a class="pill pill--ghost" href={t('cv.file')} download={t('cv.filename')} data-i18n-attr="href:cv.file;download:cv.filename">
          <span data-i18n="cv.download">{t('cv.download')}</span> ↓
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  @media (min-width: 768px) {
    .about {
      grid-template-columns: 5fr 7fr;
    }
  }

  .about__photo-wrap {
    border-radius: 2.5rem;
    overflow: hidden;
    aspect-ratio: 1;
    background: var(--surface);
  }

  .about__photo-wrap :global(.about__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  .about__copy {
    display: grid;
    gap: 1.25em;
    margin-top: clamp(2.5rem, 7vh, 5.5rem);
  }

  .about__cv {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(2rem, 5vh, 3rem);
  }

</style>
